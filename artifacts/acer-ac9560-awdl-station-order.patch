+int ItlIwm::
+iwm_awdl_configure_tx_queues(struct iwm_softc *sc, bool enable)
+{
+    const int qids[] = { IWM_AWDL_MGMT_QUEUE, IWM_AWDL_DATA_QUEUE };
+    const int tids[] = { IWM_MAX_TID_COUNT, IWM_TID_NON_QOS };
+    int *const current[] = { &sc->sc_awdl_mgmt_qid, &sc->sc_awdl_data_qid };
+    const int generation = sc->sc_generation;
+    int result = 0;
+
+    if (!iwm_nic_lock(sc))
+        return EBUSY;
+    for (unsigned i = 0; i < nitems(qids); i++) {
+        const unsigned index = enable ? i : nitems(qids) - i - 1;
+        if (enable == (*current[index] >= 0))
+            continue;
+        int error;
+        if (enable) {
+            error = iwm_enable_txq(sc, IWM_AWDL_STA_ID, qids[index],
+                iwm_ac_to_tx_fifo[EDCA_AC_BE], 0, tids[index], 0);
+        } else {
+            struct iwm_scd_txq_cfg_cmd cmd = {};
+            cmd.scd_queue = *current[index];
+            cmd.enable = IWM_SCD_CFG_DISABLE_QUEUE;
+            cmd.sta_id = IWM_AWDL_STA_ID;
+            cmd.tid = tids[index];
+            error = iwm_send_cmd_pdu(sc, IWM_SCD_QUEUE_CFG, 0, sizeof(cmd), &cmd);
+        }
+        if (generation != sc->sc_generation || sc->sc_awdl_fw_fault) {
+            result = ENXIO;
+            break;
+        }
+        if (error) {
+            if (!result)
+                result = error;
+            if (enable)
+                break;
+        } else {
+            *current[index] = enable ? qids[index] : -1;
+        }
+    }
+    iwm_nic_unlock(sc);
+    return result;
+}
+
+int ItlIwm::
+iwm_awdl_install_sta(struct iwm_softc *sc, int &stage)
+{
+    if (sc->sc_awdl_fw_fault || sc->sc_awdl_programming_station)
+        return EBUSY;
+    // Firmware 46's station-type API checks the ADD_STA queue mask.
+    // Program the scheduler before advertising those queue IDs.
+    const bool queues_first = sc->sc_device_family == IWM_DEVICE_FAMILY_9000 &&
+        isset(sc->sc_ucode_api, IWM_UCODE_TLV_API_STA_TYPE);
+    const int generation = sc->sc_generation;
+    int error = 0;
+
+    sc->sc_awdl_programming_station = true;
+    if (queues_first) {
+        stage = 5;
+        error = iwm_awdl_configure_tx_queues(sc, true);
+    }
+    if (!error && sc->sc_awdl_fw_fault)
+        error = ENXIO;
+    if (!error) {
+        stage = 4;
+        error = iwm_awdl_add_sta(sc);
+        if (generation != sc->sc_generation || sc->sc_awdl_fw_fault)
+            error = ENXIO;
+        if (!error)
+            sc->sc_awdl_sta_up = 1;
+    }
+    if (!error && !queues_first) {
+        stage = 5;
+        error = iwm_awdl_configure_tx_queues(sc, true);
+    }
+    sc->sc_awdl_programming_station = false;
+    return error;
+}
